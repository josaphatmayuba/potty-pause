    <!-- Spoken phrases (TTS) -->
    <string name="say_geant">Oh là là, j\'ai trop envie de faire pipi ! Et toi ? Allez, on y va !</string>
    <string name="say_bd">Il a envie… il court… il a réussi ! À toi de faire pareil !</string>
    <string name="say_sablier">Pendant que le sable coule, va faire pipi. Je t\'attends !</string>
    <string name="say_feu">Le feu est rouge, c\'est l\'heure du pipi ! Quand il sera vert, tu pourras rejouer.</string>
    <string name="say_nuit">La lune va bientôt dormir. Un petit pipi avant le dodo ?</string>
    <string name="say_ballon">Le ballon gonfle, gonfle… Va faire pipi avant qu\'il fasse pop !</string>
    <string name="say_carte">Suis le chemin du trésor jusqu\'aux toilettes !</string>
    <string name="say_porte">Toc toc ! Les toilettes t\'attendent. Entre vite !</string>
    <string name="say_bouton">C\'est l\'heure du pipi !</string>
    <string name="say_aqua">Les poissons se reposent. Toi, va faire pipi, puis reviens les voir !</string>
    <string name="say_dino">Oh oh, le petit dino a très envie ! Cours vite aux toilettes avec lui !</string>
    <string name="say_fusee">Trois, deux, un… décollage ! Va vite faire pipi, la fusée t\'attend !</string>
    <string name="say_train">Tchou tchou ! Le petit train va à la gare des toilettes. Monte avec lui !</string>
    <string name="say_goutte">Plouf ! La petite goutte est allée dans les toilettes. À toi maintenant !</string>
    <string name="say_photo">Regarde, c\'est ton dessin ! C\'est l\'heure d\'aller faire pipi.</string>
    <string name="say_blocs_name">%1$s, c\'est l\'heure d\'aller faire pipi. </string>
    <string name="say_blocs_noname">Hé ! C\'est l\'heure d\'aller faire pipi. </string>
    <string name="say_blocs_who">%1$s a très envie aussi ! </string>
    <string name="say_blocs_end">Va vite aux toilettes !</string>
